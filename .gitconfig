[include]
  path = ~/git/.gitconfig_shared
  path = ~/git/.gitconfig_osx
[gpg]
	program = gpg
[user]
    signingkey = A6CDECAE
	name = Paul Schoenfelder
	email = paulschoenfelder@fastmail.com
[commit]
    gpsign = true
	gpgsign = true
[tag]
	forceSignAnnotated = true
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
